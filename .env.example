ENV=dev
DATABASE_URL=postgresql+psycopg://ibotix:ibotix@localhost:5433/ibotix
TEST_DATABASE_URL=postgresql+psycopg://ibotix:ibotix@localhost:5433/ibotix_test
JWT_SECRET=change-me-to-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173
ALLOWED_EMAIL_DOMAINS=ibotix.ai
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=helpdesk@ibotix.ai
SMTP_STARTTLS=false
ATTACHMENT_DIR=./var/attachments
MAX_UPLOAD_BYTES=10485760
MAX_FILES_PER_TICKET=5
ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
TIMEZONE=Asia/Kolkata
WORKER_TICK_SECONDS=15
SLA_TIME_SCALE=1.0
MFA_REQUIRED_ROLES=
FIELD_ENCRYPTION_KEY=
